{
  "redirects": [
    {
      "source": "/",
      "destination": "https://tompearl.com",
      "permanent": false
    },
    {
      "source": "/:path((?!api).*)",
      "destination": "https://tompearl.com",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/ranking/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
